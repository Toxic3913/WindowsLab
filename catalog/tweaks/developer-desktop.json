[
  {
    "id": "developer.long-paths",
    "title": "Rutas largas (Win32 long paths)",
    "description": "LongPathsEnabled=1. Oficial; útil con git/node. HKLM: en Beta 0 solo se detecta.",
    "category": "developer",
    "risk": "LOW",
    "evidence": "OFFICIAL",
    "evidenceRefs": ["https://learn.microsoft.com/windows/win32/fileio/maximum-file-path-limitation"],
    "minBuild": 22000,
    "editions": ["*"],
    "profiles": ["developer"],
    "requires": ["toolchain.git"],
    "conflicts": [],
    "requiresReboot": true,
    "affectsSecurity": false,
    "affectsUpdates": false,
    "affectsCompatibility": true,
    "detect": { "kind": "registry", "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "LongPathsEnabled", "valueKind": "DWord" },
    "desired": { "equals": 1 },
    "ops": [{ "kind": "registry", "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "LongPathsEnabled", "valueKind": "DWord", "value": "1" }]
  },
