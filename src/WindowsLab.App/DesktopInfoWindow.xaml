<Window x:Class="WindowsLab.App.DesktopInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsLab DesktopInfo"
        Width="380" Height="420"
        MinWidth="300" MinHeight="280"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelElevatedBrush}"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <DockPanel>
        <TextBlock x:Name="StampText" DockPanel.Dock="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
        <TextBlock Text="DesktopInfo" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
      </DockPanel>
      <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
              Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1">
        <TextBlock x:Name="RecommendBanner" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </Border>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox x:Name="TopMostBox" Content="Siempre visible" IsChecked="True" VerticalAlignment="Center"
                  Foreground="{DynamicResource TextBrush}"
                  Checked="TopMostBox_OnChanged" Unchecked="TopMostBox_OnChanged"/>
        <TextBlock x:Name="OpacityLabel" Text="Opacidad" VerticalAlignment="Center" Margin="16,0,8,0"
                   Foreground="{DynamicResource MutedBrush}"/>
        <Slider x:Name="OpacitySlider" Width="100" Minimum="0.45" Maximum="1" Value="0.92"
                VerticalAlignment="Center" ValueChanged="OpacitySlider_OnChanged"/>
      </StackPanel>
      <WrapPanel>
        <Button x:Name="BtnRefresh" Content="Actualizar" Click="Refresh_OnClick" Padding="10,6" Margin="0,0,8,0"/>
        <Button x:Name="BtnCorner" Content="Esquina" Click="Corner_OnClick" Padding="10,6" Margin="0,0,8,0"/>
        <Button x:Name="BtnOpenBgInfo" Content="Usar BGInfo…" Click="OpenBgInfo_OnClick" Padding="10,6"/>
      </WrapPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource AdjustCategoryCard}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock x:Name="HostLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" Text="Equipo"/>
            <TextBlock x:Name="HostValue" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="UserValue" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="OsValue" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <UniformGrid Columns="2">
          <Border Style="{StaticResource AdjustCategoryCard}">
            <StackPanel>
              <TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="CpuValue" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock x:Name="CpuDetail" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AdjustCategoryCard}">
            <StackPanel>
              <TextBlock Text="RAM" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="RamValue" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock x:Name="RamDetail" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AdjustCategoryCard}">
            <StackPanel>
              <TextBlock x:Name="DiskLabel" Text="Disco" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="DiskValue" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AdjustCategoryCard}">
            <StackPanel>
              <TextBlock x:Name="NetLabel" Text="Red" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="NetValue" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <TextBlock x:Name="FooterHint" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
