<Window x:Class="WindowsLab.App.DesktopInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsLab DesktopInfo"
        Width="420" Height="360"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="{DynamicResource BgBrush}"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Activar BGInfo" Click="OpenBgInfo_OnClick" ToolTip="Instala/abre Sysinternals BGInfo"/>
      <Button Content="Actualizar" Click="Refresh_OnClick"/>
      <CheckBox x:Name="TopMostBox" Content="Siempre visible" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                Checked="TopMostBox_OnChanged" Unchecked="TopMostBox_OnChanged"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="Body" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
    </ScrollViewer>
  </DockPanel>
</Window>
