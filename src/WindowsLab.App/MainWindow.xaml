<Window x:Class="WindowsLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsLab"
        Height="740" Width="1180"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="4,2">
      <MenuItem x:Name="MenuFile" Header="Archivo">
        <MenuItem x:Name="MenuBackups" Header="Respaldos" Click="MenuBackups_OnClick"/>
        <MenuItem x:Name="MenuUpdates" Header="Buscar actualizaciones" Click="CheckUpdates_OnClick"/>
        <Separator/>
        <MenuItem x:Name="MenuExit" Header="Salir" Click="MenuExit_OnClick"/>
      </MenuItem>
      <MenuItem x:Name="MenuView" Header="Ver">
        <MenuItem x:Name="MenuNavHome" Header="Inicio" Tag="home" Click="MenuNav_OnClick"/>
        <MenuItem x:Name="MenuNavAdjust" Header="Ajustes" Tag="adjust" Click="MenuNav_OnClick"/>
        <MenuItem x:Name="MenuNavApps" Header="Apps" Tag="apps" Click="MenuNav_OnClick"/>
        <MenuItem x:Name="MenuNavPerf" Header="Rendimiento" Tag="performance" Click="MenuNav_OnClick"/>
        <MenuItem x:Name="MenuNavMore" Header="Más" Tag="more" Click="MenuNav_OnClick"/>
      </MenuItem>
      <MenuItem x:Name="MenuTools" Header="Herramientas">
        <MenuItem Header="DesktopInfo" Click="OpenDesktopInfo_OnClick"/>
        <MenuItem Header="BGInfo" Click="ActivateBgInfo_OnClick"/>
        <MenuItem Header="Seguridad de Windows" Click="OpenWindowsSecurity_OnClick"/>
        <MenuItem Header="Modo Dios" Click="OpenGodMode_OnClick"/>
      </MenuItem>
      <MenuItem x:Name="MenuHelp" Header="Ayuda">
        <MenuItem x:Name="MenuReleases" Header="Releases en GitHub" Click="OpenReleases_OnClick"/>
        <MenuItem x:Name="MenuAbout" Header="Acerca de WindowsLab" Click="MenuAbout_OnClick"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="16,12" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentDeepBrush}" Margin="0,0,12,0">
            <TextBlock Text="W" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="WindowsLab" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="SubtitleText" Margin="14,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                     Text="1.0 — configurar Windows con backup y control"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="LangLabel" Text="Idioma" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="LangBox" Width="72" Margin="0,0,16,0" SelectionChanged="LangBox_OnSelectionChanged">
            <ComboBoxItem Content="ES" IsSelected="True"/>
            <ComboBoxItem Content="EN"/>
          </ComboBox>
          <TextBlock x:Name="ThemeLabel" Text="Tema" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="ThemeBox" Width="100" Margin="0,0,16,0" SelectionChanged="ThemeBox_OnSelectionChanged">
            <ComboBoxItem Content="dark" Tag="dark" IsSelected="True"/>
            <ComboBoxItem Content="light" Tag="light"/>
            <ComboBoxItem Content="system" Tag="system"/>
          </ComboBox>
          <TextBlock x:Name="ProfileLabel" Text="Perfil" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="ProfileBox" Width="160" SelectionChanged="ProfileBox_OnSelectionChanged">
            <ComboBoxItem Content="balanced" IsSelected="True"/>
            <ComboBoxItem Content="developer"/>
            <ComboBoxItem Content="gaming"/>
            <ComboBoxItem Content="virtualization"/>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>
    <ListBox x:Name="Nav" DockPanel.Dock="Left" Width="168" SelectionChanged="Nav_OnSelectionChanged">
      <ListBoxItem x:Name="NavHome" Content="Inicio" Tag="home" IsSelected="True"/>
      <ListBoxItem x:Name="NavAdjust" Content="Ajustes" Tag="adjust"/>
      <ListBoxItem x:Name="NavApps" Content="Apps" Tag="apps"/>
      <ListBoxItem x:Name="NavPerformance" Content="Rendimiento" Tag="performance"/>
      <ListBoxItem x:Name="NavMore" Content="Más" Tag="more"/>
    </ListBox>
    <Grid Margin="16">
      <!-- INICIO -->
      <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="HomeSummary" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="HomeWarn" Margin="0,8,0,0" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"/>
          <TextBlock x:Name="HomeGateLine" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>

          <TextBlock x:Name="HomeModesTitle" Margin="0,20,0,6" FontSize="18" FontWeight="SemiBold" Text="Montajes"/>
          <TextBlock x:Name="HomeModesHint" Margin="0,0,0,12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Marca el montaje en Ajustes (no aplica solo). Revisa y pulsa Aplicar."/>
          <UniformGrid Columns="4">
            <Button x:Name="BtnModeEmpresa" Style="{StaticResource ModeButton}" Tag="empresa" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModeEmpresaTitle" Text="Empresa" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModeEmpresaSub" Text="Puesto de oficina" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModeEmpresaStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnModePruebas" Style="{StaticResource ModeButton}" Tag="pruebas" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModePruebasTitle" Text="Lab" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModePruebasSub" Text="VM de pruebas" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModePruebasStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnModeGaming" Style="{StaticResource ModeButton}" Tag="gaming" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModeGamingTitle" Text="Gaming" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModeGamingSub" Text="Game Mode, menos DVR" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModeGamingStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnModeDev" Style="{StaticResource ModeButton}" Tag="developer" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModeDevTitle" Text="Desarrollo" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModeDevSub" Text="Rutas largas, toolchain" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModeDevStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnModeWork" Style="{StaticResource ModeButton}" Tag="work" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModeWorkTitle" Text="Trabajo / VM" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModeWorkSub" Text="Pausar Xbox, más CPU/RAM" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModeWorkStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnModeBalanced" Style="{StaticResource ModeButton}" Tag="balanced" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModeBalancedTitle" Text="Privacidad" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModeBalancedSub" Text="Lab privacy seguro" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModeBalancedStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnModeOptimized" Style="{StaticResource ModeButton}" Tag="optimized" Click="QuickMode_OnClick">
              <StackPanel>
                <TextBlock x:Name="BtnModeOptimizedTitle" Text="Explorador" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="BtnModeOptimizedSub" Text="Rendimiento + menos chrome" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BtnModeOptimizedStat" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <TextBlock x:Name="HomeModeStatus" Margin="0,0,0,16" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>

          <TextBlock x:Name="HomePendingTitle" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,6" Text="Pendientes"/>
          <TextBlock x:Name="HomePendingHint" Margin="0,0,0,8" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
          <DataGrid x:Name="PendingGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    MaxHeight="280" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Abrir" Click="PendingActivate_OnClick" Tag="{Binding}" Padding="8,2"
                            IsEnabled="{Binding CanActivate}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="70"/>
              <DataGridTextColumn Header="Área" Binding="{Binding Section}" Width="120"/>
              <DataGridTextColumn Header="Qué" Binding="{Binding Title}" Width="220"/>
              <DataGridTextColumn Header="Cómo" Binding="{Binding HowTo}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <Expander x:Name="HomeDetailsExpander" IsExpanded="False" Margin="0,16,0,4">
            <Expander.Header>
              <TextBlock x:Name="HomeProbesTitle" FontWeight="SemiBold" Text="Detalles del equipo"/>
            </Expander.Header>
            <ItemsControl x:Name="ProbeList" Margin="0,8,0,0"/>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- AJUSTES: 2 columnas en pantallas anchas; filas compactas (sin DataGrid a todo el ancho) -->
      <DockPanel x:Name="PageAdjust" Visibility="Collapsed" SizeChanged="PageAdjust_OnSizeChanged">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock x:Name="AdjustHint" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Montaje = selección. Revisa checks y aplica una vez (con backup)."/>
          <TextBlock x:Name="AdjustPresetsLabel" FontWeight="SemiBold" Margin="0,0,0,6" Text="Montajes"/>
          <WrapPanel x:Name="AdjustPresetBar" Margin="0,0,0,8"/>
          <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <TextBox x:Name="AdjustSearchBox" DockPanel.Dock="Left" Width="240" Margin="0,0,12,0" Padding="6,4"
                     ToolTip="Buscar" TextChanged="AdjustSearch_OnChanged"/>
            <TextBlock x:Name="AdjustFilterLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Filtro"/>
            <ComboBox x:Name="AdjustFilterBox" DockPanel.Dock="Left" Width="140" SelectionChanged="AdjustFilter_OnChanged">
              <ComboBoxItem Content="Todos" Tag="all" IsSelected="True"/>
              <ComboBoxItem Content="Desalineados" Tag="gaps"/>
              <ComboBoxItem Content="Recomendados" Tag="recommended"/>
            </ComboBox>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnAdjustClear" Content="Limpiar" Click="AdjustClear_OnClick" Margin="0,0,8,0" Padding="10,4"/>
              <Button x:Name="BtnAdjustSimulate" Content="Simular" Click="AdjustSimulate_OnClick" Margin="0,0,8,0" Padding="10,4"/>
              <Button x:Name="BtnAdjustApply" Style="{StaticResource PrimaryButton}" Content="Aplicar seleccionados"
                      Click="AdjustApply_OnClick" Margin="0" Padding="10,4"/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="AdjustStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
          <ItemsControl x:Name="TweakCategoryList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource AdjustCategoryCard}">
                    <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14"
                               Text="{Binding Header}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="4,5" Margin="0,0,0,2" CornerRadius="4"
                                  Background="Transparent" ToolTip="{Binding DetailTip}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,1,8,0"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Checked="TweakSelect_OnChanged" Unchecked="TweakSelect_OnChanged"/>
                              <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                                         VerticalAlignment="Top" Margin="0,1,10,0"/>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding MatchLabel}" FontWeight="SemiBold" Width="16"
                                           TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="4"
                                        Padding="6,2" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Risk}" FontSize="11"
                                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- APPS -->
      <DockPanel x:Name="PageApps" Visibility="Collapsed">
        <TextBlock x:Name="AppsHint" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBox x:Name="AppsSearchBox" Width="200" Margin="0,0,12,0" Padding="6,4"
                   ToolTip="Buscar" TextChanged="AppsSearch_OnChanged"/>
          <TextBlock x:Name="AppsFilterLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="AppsCategoryBox" Width="150" SelectionChanged="AppsCategoryBox_OnSelectionChanged">
            <ComboBoxItem Content="Todas" Tag="all" IsSelected="True"/>
            <ComboBoxItem Content="Navegador" Tag="browser"/>
            <ComboBoxItem Content="Herramientas" Tag="tool"/>
            <ComboBoxItem Content="Sistema" Tag="system"/>
            <ComboBoxItem Content="Seguridad" Tag="security"/>
            <ComboBoxItem Content="Backup" Tag="backup"/>
            <ComboBoxItem Content="Desarrollo" Tag="developer"/>
            <ComboBoxItem Content="Virtualización" Tag="virt"/>
            <ComboBoxItem Content="Remoto / red" Tag="remote"/>
            <ComboBoxItem Content="Oficina" Tag="office"/>
            <ComboBoxItem Content="Media" Tag="media"/>
            <ComboBoxItem Content="Juegos" Tag="gaming"/>
          </ComboBox>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BtnInstallApp" Style="{StaticResource PrimaryButton}" Content="Instalar selección" Click="InstallApp_OnClick"/>
          <Button x:Name="BtnDefaultApps" Content="Apps predeterminadas" Click="OpenDefaultApps_OnClick"/>
          <TextBlock x:Name="AppsStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="70"/>
            <DataGridTextColumn Header="App" Binding="{Binding Title}" Width="140"/>
            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="90"/>
            <DataGridTextColumn Header="Estado" Binding="{Binding InstalledLabel}" Width="90"/>
            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="90"/>
            <DataGridTextColumn Header="Por qué" Binding="{Binding Why}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- RENDIMIENTO -->
      <DockPanel x:Name="PagePerformance" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBlock x:Name="PerfTitle" FontSize="18" FontWeight="SemiBold" Text="Rendimiento"/>
          <TextBlock x:Name="PerfHint" Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
          <UniformGrid Columns="3" Margin="0,0,0,8">
            <Border Margin="0,0,8,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1">
              <StackPanel>
                <TextBlock x:Name="PerfCpuLabel" Text="CPU" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="PerfCpuValue" FontSize="28" FontWeight="SemiBold" Text="—"/>
              </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1">
              <StackPanel>
                <TextBlock x:Name="PerfRamLabel" Text="RAM" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="PerfRamValue" FontSize="22" FontWeight="SemiBold" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1">
              <StackPanel>
                <TextBlock x:Name="PerfDiskLabel" Text="Disco" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="PerfDiskValue" FontSize="14" FontWeight="SemiBold" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock x:Name="PerfMeta" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="PerfFilterLabel" Text="Grupo" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PerfGroupFilter" Width="140" SelectionChanged="PerfGroupFilter_OnChanged">
              <ComboBoxItem Content="All" Tag="all" IsSelected="True"/>
              <ComboBoxItem Content="Windows" Tag="windows"/>
              <ComboBoxItem Content="Microsoft" Tag="microsoft"/>
              <ComboBoxItem Content="External" Tag="external"/>
            </ComboBox>
            <TextBlock x:Name="PerfSortHint" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          </StackPanel>
          <TextBlock x:Name="PerfFooter" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,4"/>
        </StackPanel>
        <DataGrid x:Name="PerfProcessGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70"/>
            <DataGridTextColumn Header="Group" Binding="{Binding GroupLabel}" Width="90"/>
            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="70"/>
            <DataGridTextColumn Header="Working set" Binding="{Binding WorkingSetText}" Width="110"/>
            <DataGridTextColumn Header="Private" Binding="{Binding PrivateText}" Width="110"/>
            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- MÁS -->
      <ScrollViewer x:Name="PageMore" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="SettingsThemeTitle" FontWeight="SemiBold" FontSize="16" Text="Tema" Margin="0,0,0,8"/>
          <TextBlock x:Name="SettingsThemeHint" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource MutedBrush}"/>

          <TextBlock x:Name="SettingsUpdateTitle" FontWeight="SemiBold" FontSize="16" Text="Actualizaciones" Margin="0,8,0,8"/>
          <TextBlock x:Name="SettingsVersionText" Margin="0,0,0,8" Foreground="{DynamicResource MutedBrush}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnCheckUpdatesSettings" Style="{StaticResource PrimaryButton}"
                    Content="Buscar actualizaciones" Click="CheckUpdates_OnClick" Margin="0,0,8,0" Padding="12,8"/>
            <Button x:Name="BtnOpenReleases" Content="Abrir releases en GitHub" Click="OpenReleases_OnClick" Padding="12,8"/>
          </StackPanel>
          <TextBlock x:Name="UpdateTokenHint" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}"
                     Text="Si el repo es privado, pega un token GitHub (Contents:read) para comprobar y descargar:"/>
          <DockPanel Margin="0,0,0,8" LastChildFill="True">
            <Button x:Name="BtnSaveGithubToken" DockPanel.Dock="Right" Content="Guardar token"
                    Click="SaveGithubToken_OnClick" Margin="8,0,0,0" Padding="10,4"/>
            <PasswordBox x:Name="GithubTokenBox" Height="28" Padding="6,4"/>
          </DockPanel>
          <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource MutedBrush}"/>

          <TextBlock x:Name="SettingsSystemApplyTitle" FontWeight="SemiBold" FontSize="16" Text="Apply de sistema" Margin="0,8,0,8"/>
          <TextBlock x:Name="SettingsSystemApplyHint" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MutedBrush}"/>
          <CheckBox x:Name="ChkAllowSystemApply" Content="Permitir apply de sistema (HKLM / Worker)"
                    Margin="0,0,0,16" Checked="AllowSystemApply_OnChanged" Unchecked="AllowSystemApply_OnChanged"/>

          <TextBlock x:Name="MoreWorkloadsTitle" FontWeight="SemiBold" FontSize="16" Text="Cargas externas" Margin="0,8,0,8"/>
          <TextBlock x:Name="MoreWorkloadsHint" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MutedBrush}"
                     Text="Detecta Steam, Riot, Overwolf, LibreOffice… y los detiene cuando no los uses (PC real). Lista curada; no toca Defender/Search/SysMain."/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnWorkloadRefresh" Content="Actualizar" Click="WorkloadRefresh_OnClick" Margin="0,0,8,0" Padding="10,4"/>
            <Button x:Name="BtnWorkloadStopAll" Style="{StaticResource PrimaryButton}" Content="Detener activas"
                    Click="WorkloadStopAllActive_OnClick" Padding="10,4"/>
          </StackPanel>
          <WrapPanel x:Name="WorkloadPanel" Margin="0,0,0,8"/>
          <TextBlock x:Name="WorkloadStatusText" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource MutedBrush}"/>

          <TextBlock x:Name="MoreBackupsTitle" FontWeight="SemiBold" FontSize="16" Text="Respaldos" Margin="0,0,0,8"/>
          <ListBox x:Name="BackupList" Height="120" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Actualizar lista" Click="RefreshBackups_OnClick" Margin="0,0,8,0"/>
            <Button x:Name="BtnRestoreBackup" Content="Restaurar seleccionado" Click="RestoreBackup_OnClick"/>
            <TextBlock x:Name="BackupStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <Expander x:Name="MoreSystemExpander" IsExpanded="False" Margin="0,4,0,4">
            <Expander.Header>
              <TextBlock x:Name="MoreSystemTitle" FontWeight="SemiBold" Text="Sistema"/>
            </Expander.Header>
            <StackPanel x:Name="SystemPanel" Margin="0,8,0,0"/>
          </Expander>
          <Expander x:Name="MoreSecurityExpander" IsExpanded="False" Margin="0,4,0,4">
            <Expander.Header>
              <TextBlock x:Name="MoreSecurityTitle" FontWeight="SemiBold" Text="Seguridad"/>
            </Expander.Header>
            <StackPanel x:Name="SecurityPanel" Margin="0,8,0,0"/>
          </Expander>
          <Expander x:Name="MoreToolsExpander" IsExpanded="False" Margin="0,4,0,4">
            <Expander.Header>
              <TextBlock x:Name="MoreToolsTitle" FontWeight="SemiBold" Text="Herramientas"/>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0">
              <WrapPanel>
                <Button x:Name="BtnDesktopInfo" Content="DesktopInfo" Click="OpenDesktopInfo_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnBgInfo" Style="{StaticResource PrimaryButton}" Content="BGInfo" Click="ActivateBgInfo_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnBgInfoDocs" Content="Docs BGInfo" Click="OpenBgInfoOfficial_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnGodMode" Content="Modo Dios" Click="OpenGodMode_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnActivateWindows" Content="Activar Windows" Click="ActivateWindows_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnLibreOffice" Content="LibreOffice" Click="DownloadLibreOffice_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnWindowsSecurity" Content="Seguridad de Windows" Click="OpenWindowsSecurity_OnClick" Padding="12,8" Margin="0,0,8,8"/>
                <Button x:Name="BtnDefenderRealtimeOff" Content="Defender RTP OFF" Click="DefenderRealtimeOff_OnClick" Padding="12,8" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock x:Name="HomeQuickStatus" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Expander>

          <TextBlock x:Name="SettingsChannelsTitle" FontWeight="SemiBold" FontSize="16" Margin="0,16,0,8" Text="Canales"/>
          <TextBlock x:Name="SettingsChannelsHint" Margin="0,0,0,12" TextWrapping="Wrap"/>
          <ItemsControl x:Name="ChannelList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,12"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnOpenUser" Content="Abrir carpeta de usuario" Click="OpenUserChannel_OnClick"/>
            <Button x:Name="BtnOpenMachine" Content="Abrir carpeta de máquina" Click="OpenMachineChannel_OnClick" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Margin="0,16,0,0" x:Name="SettingsCatalogPath" TextWrapping="Wrap"/>
          <TextBlock x:Name="SettingsInstallPath" Margin="0,12,0,0" TextWrapping="Wrap"/>
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Sin firma Authenticode: SmartScreen puede avisar. No usa irm|iex."/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
