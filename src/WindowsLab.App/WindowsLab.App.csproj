<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>WindowsLab</AssemblyName>
    <RootNamespace>WindowsLab.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\WindowsLab.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowsLab.Core\WindowsLab.Core.csproj" />
    <ProjectReference Include="..\WindowsLab.Audit\WindowsLab.Audit.csproj" />
    <ProjectReference Include="..\WindowsLab.Tweaks\WindowsLab.Tweaks.csproj" />
    <ProjectReference Include="..\WindowsLab.Recommendations\WindowsLab.Recommendations.csproj" />
    <ProjectReference Include="..\WindowsLab.Applications\WindowsLab.Applications.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\catalog\tweaks\*.json" Link="catalog\tweaks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\catalog\checklists\*.json" Link="catalog\checklists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\catalog\presets\*.json" Link="catalog\presets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\catalog\applications\*.json" Link="catalog\applications\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
