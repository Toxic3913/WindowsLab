{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windowslab.local/schemas/tweak.json",
  "title": "TweakDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "risk", "evidence", "minBuild", "detect", "desired", "ops"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "evidence": { "enum": ["OFFICIAL", "STRONG", "COMMUNITY", "EXPERIMENTAL", "UNKNOWN"] },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "minBuild": { "type": "integer", "minimum": 10240 },
    "maxBuild": { "type": ["integer", "null"] },
    "editions": { "type": "array", "items": { "type": "string" } },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "requiresReboot": { "type": "boolean" },
    "affectsSecurity": { "type": "boolean" },
    "affectsUpdates": { "type": "boolean" },
    "affectsCompatibility": { "type": "boolean" },
    "detect": {
      "type": "object",
      "required": ["kind", "hive", "path", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "registry" },
        "hive": { "type": "string" },
        "path": { "type": "string" },
        "name": { "type": "string" },
        "valueKind": { "type": "string" },
        "defaultIfAbsent": {
          "description": "If the registry value is missing, treat detect as this value (like winutil DefaultState). Display still notes the key was absent.",
          "type": ["string", "number", "boolean"]
        }
      }
    },
    "desired": {
      "type": "object",
      "required": ["equals"],
      "properties": {
        "equals": {}
      }
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["registry", "service", "task", "power", "handler"] },
          "hive": { "type": "string" },
          "path": { "type": "string" },
          "name": { "type": "string" },
          "valueKind": { "type": "string" },
          "value": {}
        }
      }
    }
  }
}
